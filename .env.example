APP_ENV=development
APP_VERSION=dev

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
WEB_ORIGIN=http://localhost:5173

DATABASE_PATH=./storage/loglens.db
SOURCE_STORAGE_PATH=./storage/sources
TEMP_STORAGE_PATH=./storage/temp
EXPORT_STORAGE_PATH=./storage/exports

MAX_UPLOAD_SIZE=20GB
MAX_ENTRY_SIZE=4MB
MAX_MULTILINE_LINES=1000

IMPORT_WORKERS=2
PARSER_WORKERS=4
IMPORT_BATCH_SIZE=2000
IMPORT_CHANNEL_SIZE=5000

IMPORT_ROOT=
ALLOW_SERVER_IMPORT=false

LOG_LEVEL=debug
LOG_FORMAT=json

